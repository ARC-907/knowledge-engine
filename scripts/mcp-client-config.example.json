{
  "mcpServers": {
    "knowledge-engine": {
      "command": "knowledge-engine",
      "args": ["mcp"],
      "env": {
        "KE_CORPUS_ROOT": "ABSOLUTE_PATH/corpus",
        "KE_DATA_DIR": "ABSOLUTE_PATH/engine/data",
        "KE_REGISTRY_PATH": "ABSOLUTE_PATH/corpus/registry.json"
      }
    },
    "knowledge-engine-uvx": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/ARC-907/knowledge-engine#subdirectory=engine",
        "knowledge-engine",
        "mcp"
      ],
      "env": {
        "KE_CORPUS_ROOT": "ABSOLUTE_PATH/corpus",
        "KE_DATA_DIR": "ABSOLUTE_PATH/engine/data",
        "KE_REGISTRY_PATH": "ABSOLUTE_PATH/corpus/registry.json"
      }
    }
  }
}
