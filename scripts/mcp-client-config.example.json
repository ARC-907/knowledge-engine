{
  "mcpServers": {
    "knowledge-engine": {
      "command": "ABSOLUTE_PATH/engine/.venv/bin/knowledge-engine",
      "args": ["mcp"],
      "env": {
        "KE_HOME": "ABSOLUTE_PATH"
      }
    },
    "knowledge-engine-uvx": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/ARC-907/knowledge-engine@v3.1.0#subdirectory=engine",
        "knowledge-engine",
        "mcp"
      ],
      "env": {
        "KE_HOME": "ABSOLUTE_PATH"
      }
    }
  }
}
