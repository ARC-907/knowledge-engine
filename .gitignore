# knowledge-engine — repository ignore rules
#
# The repository contains the engine package (engine/), the dashboard, the
# demo corpus (corpus/), and documentation. Runtime data, local environments,
# secrets, and generated artifacts are never committed.

# --- Python -----------------------------------------------------------------
**/__pycache__/
*.py[cod]
*$py.class
*.so
**/*.egg-info/

# Virtual environments (uv creates engine/.venv)
**/.venv/
**/venv/
**/env/

# Tool caches
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.hypothesis/

# Coverage output (pytest --cov; CI writes engine/coverage.xml)
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Runtime data and state -------------------------------------------------
# Default per-installation data directory (indexes, board databases, project
# context stores): <KE_HOME>/.knowledge-engine/, also used by the compose stack.
**/.knowledge-engine/

**/logs/
**/*.log
**/*.db
**/*.db-shm
**/*.db-wal

# Process bookkeeping written by the agent-board watchdog script
**/watchdog.pid

# Sanitized sample logs used as test fixtures are tracked on purpose.
!engine/tests/fixtures/sample_project/logs/

# --- Secrets ----------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
**/secrets/
# One-time agent-board master key written by the bootstrap endpoint. Copy the
# key somewhere safe, then delete the file.
**/board-master-key.txt

# --- Build / distribution artifacts -----------------------------------------
**/dist/
**/build/

# Dashboard CSS toolchain (dev-time only; the compiled tailwind.css is committed)
ui-src/node_modules/

# --- Editors, IDEs, and local tool caches -----------------------------------
.vscode/
.idea/
# Obsidian vault configuration, if the corpus is opened as a vault
.obsidian/

# Local scratch and superseded material (repository root only)
/archive/
/legacy/

# --- OS files ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
