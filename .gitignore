# knowledge-engine — repository ignore rules
#
# The repository contains the engine package (engine/), the dashboard, the
# demo corpus (corpus/), and documentation. Runtime data, local environments,
# secrets, and generated artifacts are never committed.

# --- Python -----------------------------------------------------------------
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
**/*.egg-info/

# Virtual environments
**/.venv/
**/venv/
**/env/
engine/.venv/

# Tool caches
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.hypothesis/

# Coverage output
.coverage
.coverage.*
coverage.xml
engine/coverage.xml
htmlcov/

# --- Runtime data and state -------------------------------------------------
# Default per-installation data directory (indexes, board databases, project
# context stores). Created next to the corpus or project being served.
**/.knowledge-engine/

**/state/
**/logs/
**/*.log
**/*.db
**/*.db-shm
**/*.db-wal
**/engine/data/*.db

# Process bookkeeping written by the agent-board watchdog script
**/watchdog.pid

# Optional-layer runtime state (sandbox / execution adapters, local routing)
**/sandbox_adapter/state/
**/sandbox_adapter/identity/
**/routing_local/data/

# Sanitized sample logs used as test fixtures are tracked on purpose.
!engine/tests/fixtures/sample_project/logs/

# --- Generated graph artifacts (regenerable) --------------------------------
**/corpus/.graph/graph.html
**/corpus/.graph/graph.json
**/corpus/.graph/GRAPH_REPORT.md
**/corpus/.graph/native.json

# --- Secrets ----------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
**/secrets/
# One-time agent-board master key written by the bootstrap endpoint. Copy the
# key somewhere safe, then delete the file.
**/board-master-key.txt

# --- Build / distribution artifacts -----------------------------------------
**/dist/
**/build/

# Dashboard CSS toolchain (dev-time only; the compiled tailwind.css is committed)
ui-src/node_modules/

# --- Editors, IDEs, and local tool caches -----------------------------------
.vscode/
.idea/
# Obsidian vault configuration and workspace state
.obsidian/
# Cloudflare Wrangler local cache
.wrangler/

# Local scratch and superseded material
archive/
legacy/

# --- OS files ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
