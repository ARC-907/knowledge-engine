    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP requests by status class",
      "datasource": {
        "type": "loki",
        "uid": "ke-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "ke-loki"
          },
          "expr": "sum by (status) (count_over_time({job=\"knowledge-engine\", component=\"uvicorn\"} | json | logger=\"uvicorn.access\" | line_format \"{{.message}}\" | regexp `\" (?P<status>[1-5])\\d\\d$` [$__interval]))",
          "legendFormat": "{{status}}xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
