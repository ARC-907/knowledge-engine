    {
      "id": 8,
      "type": "logs",
      "title": "Warnings and errors",
      "datasource": {
        "type": "loki",
        "uid": "ke-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "ke-loki"
          },
          "expr": "{job=\"knowledge-engine\", level=~\"WARNING|ERROR|CRITICAL\", component=~\"$component\"} |~ \"(?i)$search\" | json | line_format \"{{.level}} {{.logger}}: {{.message}}{{if .exc}}\\n{{.exc}}{{end}}\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 9,
